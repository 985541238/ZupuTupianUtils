# 后端端口（前端 vite 代理默认指向 8081）
PORT=8081

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=zupu
DB_PASS=
DB_NAME=zupu_scan
# 本机快速自测可用 sqlite（需先 npm i better-sqlite3 --no-save）
# DB_TYPE=sqlite

# 必填：随机长字符串。登录凭证和库里加密的 API Key 都依赖它，部署后不要再改
JWT_SECRET=
JWT_EXPIRES=7d

# 首次启动自动创建 admin 时使用的密码
ADMIN_PASSWORD=

# 处理结果存放目录，默认 ../data/output
OUTPUT_ROOT=

# 指定 Python（需装 opencv-python、numpy），默认依次尝试 python3 / python / py
PYTHON_BIN=

# 也可以在这里放阿里云 Key（配置页填写的优先）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# 1 = 不调用阿里云，返回模拟结果（演示/联调用）
AI_MOCK=

# 测试服务器环境变量示例：复制为 .env（与 docker-compose.test.yml 同目录）后按实际值填写
# ⚠️ 不入库、不进镜像

# 数据库（共享 MySQL 8.0，由部署侧提供）
DB_HOST=mysql.example.internal
DB_PORT=3306
DB_USER=zupu
DB_PASS=请填写实际密码
DB_NAME=zupu_scan

# 鉴权（务必改成随机长串：openssl rand -hex 32）
JWT_SECRET=请替换为随机32字节
JWT_EXPIRES=7d
# 平台 Key 的加密密钥；留空则复用 JWT_SECRET
SETTINGS_SECRET=

# 本服务对外地址（平台走「公网链接」传图时用，可选）
PUBLIC_BASE_URL=

# 1 = 不真实调用大模型（测试期可置 1 避免产生费用；要用 AI 功能请留空）
AI_MOCK=

# 镜像地址（换版本时改这里）
IMAGE=ccr.ccs.tencentyun.com/100000659505/zupu-scan:v1.0.0

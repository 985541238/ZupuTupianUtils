PORT=8081
DB_HOST=localhost
DB_PORT=3306
DB_USER=zupu
DB_PASS=
DB_NAME=zupu_scan
JWT_SECRET=__JWT_SECRET__
JWT_EXPIRES=7d
# 加密已保存的模型 Key 用；改了之后需重新填写各平台 Key
SETTINGS_SECRET=__SETTINGS_SECRET__
# 数据目录（输出图、上传的图片）。留空 = 仓库下的 data\；建议指向大容量盘，如 D:\zupu-data\output
OUTPUT_ROOT=
UPLOAD_ROOT=
DEFAULT_SOURCE_FOLDER=
# 模型平台要求公网链接传图时填本服务的公网地址（可选）
PUBLIC_BASE_URL=

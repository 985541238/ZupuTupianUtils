<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 站点根目录放这个文件：整站反向代理到 Node 服务（Nest 单进程）
  前置条件：
    1. 装 URL Rewrite 2.0 + Application Request Routing (ARR)
    2. IIS 根节点 → Application Request Routing Cache → Server Proxy Settings → 勾选 Enable proxy
    3. Node 服务已在 127.0.0.1:8081 运行（deploy\windows\start.cmd / 计划任务 ZupuWorkbench）
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ZupuReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8081/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- 把后端的 JSON 错误原样透出，避免被 IIS 自定义错误页盖掉 -->
    <httpErrors existingResponse="PassThrough" />

    <!-- 上传/打包下载大文件：默认 30MB 太小，放到 1GB -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1073741824" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>

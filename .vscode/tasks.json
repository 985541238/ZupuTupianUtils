    {
      "label": "运行: 停止 8080/8888",
      "type": "shell",
      "command": "$ports = 8080,8888; foreach ($p in $ports) { Get-NetTCPConnection -LocalPort $p -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue; Write-Host \"stopped PID $($_.OwningProcess) on $p\" } }; Write-Host done",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    }
